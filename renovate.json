{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "minimumReleaseAge": "14 days",
  "extends": [
    "config:best-practices"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update tool versions in runner/Dockerfile",
      "managerFilePatterns": ["/^runner\\/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+) versioning=(?<versioning>[a-z0-9-]+)(?: extractVersion=(?<extractVersion>\\S+))?\\s+ARG [A-Z0-9_]+_VERSION=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "myoung34/github-runner"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "schedule": ["on sunday"],
      "minimumReleaseAge": "0 days",
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "matchManagers": [
        "gomod"
      ],
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "matchDepNames": ["node"],
      "allowedVersions": "20.x"
    },
    {
      "matchDepNames": ["node24"],
      "allowedVersions": "24.x"
    }
  ]
}
