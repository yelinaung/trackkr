{
  "manifest_version": 3,
  "name": "trackkr",
  "version": "0.1.0",
  "description": "Reports the active tab to a trackkrd daemon running on this machine.",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "storage",
    "idle"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background-cr.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "trackkr",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
